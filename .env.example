# OpenRouter API Configuration (Required for live AI dialogue)
OPENROUTER_API_KEY=
SEEKER_MODEL=google/gemini-2.5-flash-lite
SKEPTIC_MODEL=openai/gpt-4o-mini

# Optional Server Port (Defaults to 3000)
PORT=3000

# GEMINI_API_KEY: Automatically injected by AI Studio if configured
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
